# Copy this file to `.env` and fill in your real key.
# `.env` is git-ignored.

# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any OpenRouter model id. Default is fast + cheap + 1M context.
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: override the directory to organize. Defaults to ~/Downloads.
# DOWNLOADS_DIR=/Users/you/Downloads

# Optional: safety threshold in days. Files newer than this cannot be moved.
MIN_AGE_DAYS=7

# Optional: hard cap on LLM turns.
MAX_ITERATIONS=25
